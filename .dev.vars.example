TYPESAFE_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
BROWSERBASE_API_KEY=
TELEGRAM_BOT_TOKEN=
DEEPGRAM_API_KEY=
MAPBOX_ACCESS_TOKEN=
# Needed by chat, and by `pnpm snapshot:build --llm-headlines`. The default snapshot build makes no model call and needs no key.
GROQ_API_KEY=
# Optional: leave blank to use the defaults (openai/gpt-oss-120b writes answers, openai/gpt-oss-20b routes questions).
GROQ_CHAT_MODEL=
GROQ_ROUTER_MODEL=
# Optional: the model that judges faithfulness in `pnpm eval:chat` (default openai/gpt-oss-20b).
GROQ_JUDGE_MODEL=
# Optional: unset, /telegram is a stub that answers "ok" and runs nothing.
TELEGRAM_ENABLED=
# Optional: when set, /telegram only accepts requests that carry it (register the webhook with the same secret_token).
TELEGRAM_WEBHOOK_SECRET=
