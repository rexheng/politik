{
	"name": "politik",
	"main": "photon/src/worker.ts",
	"compatibility_date": "2026-09-26",
	"assets": {
		"directory": "./photon/public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/telegram"]
	},
	"observability": { "enabled": true },
	"ratelimits": [
		{
			"name": "ASK_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "VOICE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 2, "period": 60 }
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "politik",
			"database_id": "7cc577f7-9608-4456-ac6b-77532967ecbd",
			"migrations_dir": "migrations"
		}
	]
}
