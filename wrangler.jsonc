{
	"name": "politik",
	"main": "photon/src/worker.ts",
	"compatibility_date": "2026-09-26",
	"assets": {
		"directory": "./photon/public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/telegram"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "politik",
			"database_id": "7cc577f7-9608-4456-ac6b-77532967ecbd",
			"migrations_dir": "migrations"
		}
	]
}
